# UAT environment — pre-configured for local Docker services.
# Clone the repo and run ./scripts/be-uat directly; no edits needed for local UAT.
# For a real UAT server, replace the values below with your actual server credentials.

SERVER_PORT=8090

# PostgreSQL
DATABASE_URL=jdbc:postgresql://localhost:5442/shresta
DATABASE_USERNAME=shresta_app
DATABASE_PASSWORD=change-me
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2

# Redis
REDIS_HOST=localhost
REDIS_PORT=6389
REDIS_PASSWORD=
REDIS_TIMEOUT=2s

# Admin API
SHRESTA_ADMIN_API_KEY=local-shresta-admin-key

# Media / MinIO (local)
SHRESTA_MEDIA_ASSET_BASE_URL=http://localhost:9010/shresta-local-assets
SHRESTA_MEDIA_DELIVERY_MODE=s3-compatible-local
SHRESTA_ASSET_STORAGE_PROVIDER=s3-compatible-local
SHRESTA_ASSET_DELIVERY_MODE=s3-compatible-local
SHRESTA_ASSET_OBJECT_UPLOAD_ENABLED=true
SHRESTA_ASSET_OBJECT_ENDPOINT=http://localhost:9010
SHRESTA_ASSET_OBJECT_BUCKET=shresta-local-assets
SHRESTA_ASSET_OBJECT_REGION=us-east-1
SHRESTA_ASSET_OBJECT_ACCESS_KEY=shresta_minio
SHRESTA_ASSET_OBJECT_SECRET_KEY=shresta-local-minio-password
SHRESTA_ASSET_OBJECT_PATH_STYLE=true
SHRESTA_ASSET_OBJECT_CACHE_CONTROL=public,max-age=31536000,immutable

# Redis KV cache
SHRESTA_KV_ENABLED=true
SHRESTA_KV_KEY_PREFIX=shresta:uat

# Idempotency / mutation locking
SHRESTA_IDEMPOTENCY_ENABLED=true
SHRESTA_IDEMPOTENCY_REQUIRE_KEY=true
SHRESTA_IDEMPOTENCY_TTL=24h
SHRESTA_MUTATION_LOCKING_ENABLED=true
SHRESTA_MUTATION_LOCK_TTL=30s

# Auth
JWT_PUBLIC_KEY_BASE64=replace-in-real-env
JWT_PRIVATE_KEY_BASE64=replace-in-real-env

# Razorpay
RAZORPAY_KEY_ID=replace-in-real-env
RAZORPAY_KEY_SECRET=replace-in-real-env
RAZORPAY_WEBHOOK_SECRET=replace-in-real-env

SHRESTA_RAZORPAY_WEBHOOK_ENABLED=true
SHRESTA_RAZORPAY_WEBHOOK_SECRET=local_razorpay_webhook_secret
