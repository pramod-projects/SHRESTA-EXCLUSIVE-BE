#!/usr/bin/env sh
set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
REPO_ROOT=$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)

if [ -f "$REPO_ROOT/.env" ]; then
  set -a
  . "$REPO_ROOT/.env"
  set +a
fi

SOURCE_DIR=${SHRESTA_MEDIA_SOURCE_DIR:-"$REPO_ROOT/seed/shresta-media"}
BUCKET=${SHRESTA_S3_BUCKET:-}
PREFIX=${SHRESTA_S3_PREFIX:-}
CACHE_CONTROL=${SHRESTA_S3_CACHE_CONTROL:-"public,max-age=31536000,immutable"}

if [ -z "$BUCKET" ]; then
  echo "SHRESTA_S3_BUCKET is required" >&2
  exit 1
fi

if ! command -v aws >/dev/null 2>&1; then
  echo "aws CLI is required to upload SHRESTA media" >&2
  exit 1
fi

if [ ! -d "$SOURCE_DIR" ]; then
  echo "Media source directory not found: $SOURCE_DIR" >&2
  exit 1
fi

PREFIX=$(printf "%s" "$PREFIX" | sed 's#^/##; s#/$##')
if [ -n "$PREFIX" ]; then
  DESTINATION="s3://$BUCKET/$PREFIX/"
else
  DESTINATION="s3://$BUCKET/"
fi

aws s3 sync "$SOURCE_DIR/" "$DESTINATION" \
  --cache-control "$CACHE_CONTROL" \
  --metadata-directive REPLACE

"$SCRIPT_DIR/verify-shresta-media-s3"
