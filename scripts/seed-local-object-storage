#!/usr/bin/env sh
set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
REPO_ROOT=$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)

ENV_FILE="$REPO_ROOT/.env.dev"
if [ -f "$ENV_FILE" ]; then
  set -a
  . "$ENV_FILE"
  set +a
fi

cd "$REPO_ROOT"
docker-compose --env-file "$ENV_FILE" -f docker-compose.dev.yml up -d minio
docker-compose --env-file "$ENV_FILE" -f docker-compose.dev.yml up minio-setup

MEDIA_PUBLIC_BASE_URL=${MEDIA_PUBLIC_BASE_URL:-http://localhost:9010/shresta-local-assets} \
  "$SCRIPT_DIR/verify-media-delivery"
