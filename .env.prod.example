# Production environment — copy to .env.prod and fill in all values.
# .env.prod is gitignored and must never be committed.

SERVER_PORT=8090

# PostgreSQL
DATABASE_URL=jdbc:postgresql://YOUR_PROD_DB_HOST:5432/shresta
DATABASE_USERNAME=shresta_app
DATABASE_PASSWORD=YOUR_DB_PASSWORD
DB_POOL_MAX_SIZE=20
DB_POOL_MIN_IDLE=5

# Redis
REDIS_HOST=YOUR_PROD_REDIS_HOST
REDIS_PORT=6389
REDIS_PASSWORD=YOUR_REDIS_PASSWORD
REDIS_TIMEOUT=3s

# Admin API
SHRESTA_ADMIN_API_KEY=YOUR_ADMIN_API_KEY

# Media / S3
SHRESTA_MEDIA_ASSET_BASE_URL=https://YOUR_CDN_OR_BUCKET_ORIGIN/shresta-assets
SHRESTA_MEDIA_DELIVERY_MODE=s3-compatible
SHRESTA_ASSET_STORAGE_PROVIDER=s3-compatible
SHRESTA_ASSET_DELIVERY_MODE=s3-compatible
SHRESTA_ASSET_OBJECT_UPLOAD_ENABLED=true
SHRESTA_ASSET_OBJECT_ENDPOINT=https://s3.YOUR_REGION.amazonaws.com
SHRESTA_ASSET_OBJECT_BUCKET=shresta-assets
SHRESTA_ASSET_OBJECT_REGION=YOUR_REGION
SHRESTA_ASSET_OBJECT_ACCESS_KEY=YOUR_ACCESS_KEY
SHRESTA_ASSET_OBJECT_SECRET_KEY=YOUR_SECRET_KEY
SHRESTA_ASSET_OBJECT_PATH_STYLE=false
SHRESTA_ASSET_OBJECT_CACHE_CONTROL=public,max-age=31536000,immutable

# Redis KV cache — must differ from uat to avoid key collisions
SHRESTA_KV_ENABLED=true
SHRESTA_KV_KEY_PREFIX=shresta:prod

# Idempotency / mutation locking
SHRESTA_IDEMPOTENCY_ENABLED=true
SHRESTA_IDEMPOTENCY_REQUIRE_KEY=true
SHRESTA_IDEMPOTENCY_TTL=24h
SHRESTA_MUTATION_LOCKING_ENABLED=true
SHRESTA_MUTATION_LOCK_TTL=30s

# Auth (RSA key pair — base64-encoded PEM)
JWT_PUBLIC_KEY_BASE64=YOUR_BASE64_PUBLIC_KEY
JWT_PRIVATE_KEY_BASE64=YOUR_BASE64_PRIVATE_KEY

# Razorpay
RAZORPAY_KEY_ID=YOUR_RAZORPAY_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_KEY_SECRET
RAZORPAY_WEBHOOK_SECRET=YOUR_RAZORPAY_WEBHOOK_SECRET
SHRESTA_RAZORPAY_WEBHOOK_SECRET=
