# Independent production template — copy to .env.prod and fill in all values.
# .env.prod is gitignored and must never be committed.

# Runtime identity and canonical customer/admin/API origins.
SERVER_PORT=8090
SHRESTA_ENVIRONMENT_MODE=PROD
SHRESTA_STOREFRONT_URL=https://shrestaexclusive.com
SHRESTA_ADMIN_URL=https://admin.shrestaexclusive.com
SHRESTA_API_URL=https://api.shrestaexclusive.com
SHRESTA_CLOUDFLARE_TUNNEL_NAME=shresta-prod-api
# Customer-visible support contacts used in transactional email footers.
SHRESTA_SUPPORT_EMAIL=support@shrestaexclusive.com
SHRESTA_SUPPORT_PHONE_DISPLAY="+91 12345 67890"
SHRESTA_SUPPORT_PHONE_DIAL=+911234567890

# PostgreSQL durable storage. Size the pool against the database connection budget.
DATABASE_URL=jdbc:postgresql://YOUR_PROD_DB_HOST:5432/shresta
DATABASE_USERNAME=shresta_app
DATABASE_PASSWORD=YOUR_DB_PASSWORD
DB_POOL_MAX_SIZE=20
DB_POOL_MIN_IDLE=5
# Override only when intentionally using a nonstandard Flyway migration location.
SHRESTA_FLYWAY_LOCATIONS=classpath:db/migration

# Redis volatile state. PROD must use a dedicated instance or isolated prefix.
REDIS_HOST=YOUR_PROD_REDIS_HOST
REDIS_PORT=6389
REDIS_PASSWORD=YOUR_REDIS_PASSWORD
REDIS_TIMEOUT=3s

# Server-to-server admin bridge key. Never send this value to browser JavaScript.
SHRESTA_ADMIN_API_KEY=YOUR_ADMIN_API_KEY
# Creates the one initial SUPER_ADMIN when absent. Use a unique strong password.
SHRESTA_ADMIN_BOOTSTRAP_EMAIL=pramod.works.on.projects@gmail.com
SHRESTA_ADMIN_BOOTSTRAP_PASSWORD=YOUR_PROD_BOOTSTRAP_ADMIN_PASSWORD
SHRESTA_ADMIN_BOOTSTRAP_ROLE=SUPER_ADMIN

# Cloudflare R2 media. MinIO is DEV-only and must not be deployed in PROD.
# Public base is the custom read domain; endpoint is the private S3-compatible API origin.
MEDIA_PUBLIC_BASE_URL=https://YOUR_PROD_MEDIA_DOMAIN
SHRESTA_MEDIA_DELIVERY_MODE=cloudflare-r2
R2_ACCOUNT_ID=YOUR_CLOUDFLARE_ACCOUNT_ID
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET_NAME=YOUR_PROD_R2_BUCKET
R2_REGION=auto
R2_ACCESS_KEY_ID=YOUR_R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=YOUR_R2_SECRET_ACCESS_KEY
# Required by the tested Cloudflare R2 client configuration.
R2_PATH_STYLE=true
# Cache TTL is seconds; upload TTL is a Spring duration; file-size limits are bytes.
MEDIA_BROWSER_CACHE_MAX_AGE_SECONDS=604800
MEDIA_UPLOAD_URL_TTL=10m
MEDIA_CANONICAL_MAX_WIDTH=2400
MEDIA_CANONICAL_MAX_HEIGHT=3200
MEDIA_CANONICAL_MAX_FILE_SIZE=15000000
MEDIA_VIDEO_MAX_FILE_SIZE=100000000

# Redis read-through cache. Prefix must differ from DEV and UAT to avoid collisions.
SHRESTA_KV_ENABLED=true
SHRESTA_KV_KEY_PREFIX=shresta:prod
# Per-table cache controls use Spring duration values. Tune only after measuring
# hit rate, staleness requirements, and Redis memory in production.
SHRESTA_KV_CATEGORY_FAMILY_ENABLED=true
SHRESTA_KV_CATEGORY_FAMILY_TTL=300s
SHRESTA_KV_CATEGORY_PRODUCT_TYPE_ENABLED=true
SHRESTA_KV_CATEGORY_PRODUCT_TYPE_TTL=300s
SHRESTA_KV_CATEGORY_ATTRIBUTE_ENABLED=true
SHRESTA_KV_CATEGORY_ATTRIBUTE_TTL=300s
SHRESTA_KV_CATEGORY_FILTER_ENABLED=true
SHRESTA_KV_CATEGORY_FILTER_TTL=300s
SHRESTA_KV_CATEGORY_TAX_ENABLED=true
SHRESTA_KV_CATEGORY_TAX_TTL=300s
SHRESTA_KV_CATEGORY_STYLING_ENABLED=true
SHRESTA_KV_CATEGORY_STYLING_TTL=300s
SHRESTA_KV_STOREFRONT_SECTIONS_ENABLED=true
SHRESTA_KV_STOREFRONT_SECTIONS_TTL=120s
SHRESTA_KV_STOREFRONT_ITEMS_ENABLED=true
SHRESTA_KV_STOREFRONT_ITEMS_TTL=120s
SHRESTA_KV_MEDIA_ASSETS_ENABLED=true
SHRESTA_KV_MEDIA_ASSETS_TTL=120s
SHRESTA_KV_STOREFRONT_STORE_SECTIONS_ENABLED=true
SHRESTA_KV_STOREFRONT_STORE_SECTIONS_TTL=120s
SHRESTA_KV_STORE_LOCATIONS_ENABLED=true
SHRESTA_KV_STORE_LOCATIONS_TTL=120s

# Write safety: reject missing/replayed keys and serialize conflicting mutations.
SHRESTA_IDEMPOTENCY_ENABLED=true
SHRESTA_IDEMPOTENCY_REQUIRE_KEY=true
SHRESTA_IDEMPOTENCY_TTL=24h
SHRESTA_MUTATION_LOCKING_ENABLED=true
SHRESTA_MUTATION_LOCK_TTL=30s

# SMS providers (SpringEdge primary, MSG91 fallback). All keys/tokens are server-only.
SHRESTA_SMS_ENABLED=true
SHRESTA_SMS_SPRINGEDGE_ENDPOINT=https://api.springedge.com/v1/sms/send
SHRESTA_SMS_SPRINGEDGE_API_MODE=json-v1
SHRESTA_SMS_SPRINGEDGE_API_KEY=YOUR_SPRINGEDGE_API_KEY
SHRESTA_SMS_SPRINGEDGE_SENDER=YOUR_SPRINGEDGE_SENDER
SHRESTA_SMS_SPRINGEDGE_ROUTE=transactional
SHRESTA_SMS_SPRINGEDGE_COUNTRY_CODE=91
SHRESTA_SMS_SPRINGEDGE_WEBHOOK_AUTH_ENABLED=true
SHRESTA_SMS_SPRINGEDGE_WEBHOOK_AUTH_HEADER=x-springedge-webhook-token
SHRESTA_SMS_SPRINGEDGE_WEBHOOK_AUTH_TOKEN=YOUR_SPRINGEDGE_WEBHOOK_TOKEN
SHRESTA_SMS_SPRINGEDGE_WEBHOOK_SIGNATURE_ENABLED=false
SHRESTA_SMS_SPRINGEDGE_WEBHOOK_SIGNATURE_HEADER=x-springedge-signature
SHRESTA_SMS_SPRINGEDGE_WEBHOOK_SIGNATURE_SECRET=YOUR_SPRINGEDGE_WEBHOOK_SIGNATURE_SECRET
SHRESTA_SMS_MSG91_ENDPOINT=https://control.msg91.com/api/v5/flow
SHRESTA_SMS_MSG91_API_MODE=flow-v5
SHRESTA_SMS_MSG91_AUTH_KEY=YOUR_MSG91_AUTH_KEY
SHRESTA_SMS_MSG91_SENDER=YOUR_MSG91_SENDER
SHRESTA_SMS_MSG91_ROUTE=4
SHRESTA_SMS_MSG91_COUNTRY=91
SHRESTA_SMS_MSG91_TEMPLATE_ID=YOUR_MSG91_FLOW_TEMPLATE_ID
SHRESTA_SMS_MSG91_TEMPLATE_VARIABLE_KEY=OTP
SHRESTA_SMS_MSG91_WEBHOOK_AUTH_ENABLED=true
SHRESTA_SMS_MSG91_WEBHOOK_AUTH_HEADER=x-msg91-webhook-token
SHRESTA_SMS_MSG91_WEBHOOK_AUTH_TOKEN=YOUR_MSG91_WEBHOOK_TOKEN
SHRESTA_SMS_MSG91_WEBHOOK_SIGNATURE_ENABLED=false
SHRESTA_SMS_MSG91_WEBHOOK_SIGNATURE_HEADER=x-msg91-signature
SHRESTA_SMS_MSG91_WEBHOOK_SIGNATURE_SECRET=YOUR_MSG91_WEBHOOK_SIGNATURE_SECRET

# Transactional email providers; keys and webhook secrets remain backend-only.
SHRESTA_EMAIL_ENABLED=true
SHRESTA_EMAIL_SENDER=no-reply@notify.shrestaexclusive.com
SHRESTA_EMAIL_SENDER_NAME=SHRESTA
SHRESTA_EMAIL_PROVIDER_ORDER=BREVO,RESEND,MAILJET,MAILERSEND,ELASTIC_EMAIL
SHRESTA_EMAIL_UAT_ALLOWLIST=
SHRESTA_EMAIL_UAT_RECIPIENT_OVERRIDE=
SHRESTA_EMAIL_MAX_ATTEMPTS=6
SHRESTA_EMAIL_BATCH_SIZE=20
SHRESTA_EMAIL_LEASE_DURATION=2m
SHRESTA_EMAIL_CONNECT_TIMEOUT=5s
SHRESTA_EMAIL_READ_TIMEOUT=20s
SHRESTA_EMAIL_BASE_RETRY_DELAY=30s
SHRESTA_EMAIL_MAX_RETRY_DELAY=2h
SHRESTA_EMAIL_TERMINAL_RETENTION=30d
SHRESTA_EMAIL_WEBHOOK_RETENTION=90d
SHRESTA_EMAIL_UNKNOWN_OUTCOME_ALERT_AGE=15m
SHRESTA_EMAIL_POLL_DELAY_MS=5000
SHRESTA_EMAIL_WEBHOOK_RECONCILE_DELAY_MS=5000
SHRESTA_EMAIL_BREVO_ENABLED=true
SHRESTA_EMAIL_BREVO_ENDPOINT=https://api.brevo.com/v3/smtp/email
SHRESTA_EMAIL_BREVO_API_KEY=YOUR_BREVO_API_KEY
SHRESTA_EMAIL_BREVO_WEBHOOK_SECRET=YOUR_BREVO_WEBHOOK_SECRET
SHRESTA_EMAIL_RESEND_ENABLED=true
SHRESTA_EMAIL_RESEND_ENDPOINT=https://api.resend.com/emails
SHRESTA_EMAIL_RESEND_API_KEY=YOUR_RESEND_API_KEY
SHRESTA_EMAIL_RESEND_WEBHOOK_SECRET=YOUR_RESEND_WEBHOOK_SECRET
SHRESTA_EMAIL_MAILJET_ENABLED=true
SHRESTA_EMAIL_MAILJET_ENDPOINT=https://api.mailjet.com/v3.1/send
SHRESTA_EMAIL_MAILJET_API_KEY=YOUR_MAILJET_API_KEY
SHRESTA_EMAIL_MAILJET_SECRET_KEY=YOUR_MAILJET_SECRET_KEY
SHRESTA_EMAIL_MAILJET_WEBHOOK_USERNAME=YOUR_MAILJET_WEBHOOK_USERNAME
SHRESTA_EMAIL_MAILJET_WEBHOOK_PASSWORD=YOUR_MAILJET_WEBHOOK_PASSWORD
SHRESTA_EMAIL_MAILERSEND_ENABLED=true
SHRESTA_EMAIL_MAILERSEND_ENDPOINT=https://api.mailersend.com/v1/email
SHRESTA_EMAIL_MAILERSEND_API_KEY=YOUR_MAILERSEND_API_KEY
SHRESTA_EMAIL_MAILERSEND_WEBHOOK_SECRET=YOUR_MAILERSEND_WEBHOOK_SECRET
SHRESTA_EMAIL_ELASTIC_ENABLED=true
SHRESTA_EMAIL_ELASTIC_ENDPOINT=https://api.elasticemail.com/v4/emails/transactional
SHRESTA_EMAIL_ELASTIC_API_KEY=YOUR_ELASTIC_EMAIL_API_KEY
SHRESTA_EMAIL_ELASTIC_WEBHOOK_SECRET=YOUR_ELASTIC_EMAIL_WEBHOOK_SECRET

# Auth RSA key pair as base64-encoded PEM. The private key must never leave the backend.
JWT_PUBLIC_KEY_BASE64=YOUR_BASE64_PUBLIC_KEY
JWT_PRIVATE_KEY_BASE64=YOUR_BASE64_PRIVATE_KEY

# Razorpay Standard Checkout credentials. Webhook verification is payment truth.
RAZORPAY_KEY_ID=YOUR_RAZORPAY_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_KEY_SECRET
SHRESTA_RAZORPAY_CHECKOUT_ENABLED=true
SHRESTA_RAZORPAY_ORDER_ENDPOINT=https://api.razorpay.com/v1/orders
SHRESTA_RAZORPAY_WEBHOOK_ENABLED=true
RAZORPAY_WEBHOOK_SECRET=YOUR_RAZORPAY_WEBHOOK_SECRET
# Optional preferred override; leave blank to use RAZORPAY_WEBHOOK_SECRET above.
SHRESTA_RAZORPAY_WEBHOOK_SECRET=
